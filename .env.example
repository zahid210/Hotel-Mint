# Copia este archivo a .env y define valores seguros y aleatorios.
# docker compose lee .env automáticamente. El stack FALLA si faltan variables obligatorias.
#
#   cp .env.example .env
#   # Genera claves seguras (ej: openssl rand -base64 32):
#   docker compose up -d --build

# ── Base de datos (OBLIGATORIAS) ────────────────────────────────
DB_NAME=hotel_bahia
DB_USER=hotel
# Contraseña para el usuario de la BD (OBLIGATORIA)
DB_PASSWORD=
# Contraseña para el usuario root de MariaDB (OBLIGATORIA)
DB_ROOT_PASSWORD=

# ── Backend ────────────────────────────────────────────────────
# OBLIGATORIO: Secreto criptográfico largo (ej: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
APP_TIMEZONE=America/Lima

# ── Administrador inicial ───────────────────────────────────────
# Se registra únicamente si la base de datos no tiene usuarios.
APP_ADMIN_EMAIL=zahidmatos@hotel.com
APP_ADMIN_NOMBRE=Zahid Matos
# Contraseña del administrador inicial (OBLIGATORIA, mínimo 12 caracteres recomendados)
APP_ADMIN_PASSWORD=

# ── Datos de prueba / Demo ─────────────────────────────────────
# Por defecto false. Si es true, precarga usuarios demo (recepción/limpieza) y reservas.
APP_SEED_DEMO=false

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
FRONTEND_URL=https://localhost,http://localhost
