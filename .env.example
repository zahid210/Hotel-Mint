# Copia este archivo a .env y ajusta los valores si lo necesitas.
# docker compose lee .env automáticamente; todo tiene default seguro para dev.
#
#   cp .env.example .env
#   docker compose up -d --build

# ── Base de datos ──────────────────────────────────────────────
DB_NAME=hotel_bahia
DB_USER=hotel
DB_PASSWORD=hotel_bahia
DB_ROOT_PASSWORD=root_local

# ── Backend ────────────────────────────────────────────────────
# OBLIGATORIO para docker: cambia este valor por uno aleatorio largo
# (ej: openssl rand -base64 48). El stack NO arranca sin JWT_SECRET.
JWT_SECRET=dev-solo-cambiar-esto-openssl-rand-base64-48-por-favor!!
JWT_EXPIRATION_MS=86400000
APP_TIMEZONE=America/Lima

# ── Administrador inicial (solo se crea si la BD está vacía) ───
# En producción cambia APP_ADMIN_PASSWORD; en blanco = no se crea.
APP_ADMIN_EMAIL=zahidmatos@hotel.com
APP_ADMIN_NOMBRE=Zahid Matos
APP_ADMIN_PASSWORD=hotel_bahia

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_PORT=80
